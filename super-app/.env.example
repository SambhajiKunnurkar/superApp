# OpenWeatherMap — free tier at https://openweathermap.org/api
# Sign up → API keys → copy "Default" key
VITE_WEATHER_API_KEY=your_openweathermap_key_here

# NewsAPI — free tier at https://newsapi.org
# Sign up → copy the API key from your account page
VITE_NEWS_API_KEY=your_newsapi_key_here

# OMDB — free tier at https://www.omdbapi.com/apikey.aspx
# Request a free key → check your email → paste it here
VITE_OMDB_API_KEY=your_omdb_key_here